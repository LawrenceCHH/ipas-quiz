# macOS
.DS_Store

# Tool symlinks (point to ~/.agents/skills-bullpen/, not portable)
.claude/
.agents/

# Sidecar / temp files
*.tmp
quiz-pool-combined.json

# Vercel CLI metadata (generated when running `vercel` or `vercel link`)
.vercel/

# Personal notes (per-user score trackers, hand-written reflections)
# Kept local only; never pushed to a public repo.
notes/

# Raw source PDFs staged before extraction (large, non-ASCII filenames)
source_pdfs/

# extract_exam.py stage-1/stage-2 checkpoints (deterministic, regenerable
# from the PDF; not meant to be committed alongside the real exam-*.json)
subjects/*/.checkpoints/

# tools/ is a uv project (pyproject.toml + uv.lock are what should be
# committed) -- its venv and bytecode cache are local/regenerable.
tools/.venv/
tools/__pycache__/
tools/**/__pycache__/
